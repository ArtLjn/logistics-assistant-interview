#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export AGENT_LLM="${AGENT_LLM:-off}"
export PYTHONDONTWRITEBYTECODE=1

case "${1:-}:${2:-}" in
  python:start|python:test)
    if [[ ! -x .venv/bin/python ]]; then
      python3.11 -m venv .venv
    fi
    .venv/bin/python -m pip --disable-pip-version-check install --quiet --no-index \
      --find-links .offline/wheels -r python/requirements.txt
    export PYTHONPATH="$PWD/python"
    if [[ "$2" == start ]]; then
      exec .venv/bin/python -m uvicorn logistics_exam.app:app --host 127.0.0.1 --port 8000
    fi
    exec .venv/bin/python -m unittest discover -s python/tests
    ;;
  java:start|java:test)
    if [[ "$2" == start ]]; then
      goal=spring-boot:run
    else
      goal=test
    fi
    exec mvn --offline --batch-mode -s .mvn-offline-settings.xml -gs .mvn-offline-settings.xml \
      "-Dmaven.repo.local=$PWD/.offline/maven" -f java/pom.xml "$goal"
    ;;
  *)
    echo '用法：bash scripts/run {python|java} {start|test}' >&2
    exit 2
    ;;
esac
